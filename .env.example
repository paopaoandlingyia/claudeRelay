# Copy this file to .env and replace both key values before running Docker Compose.
CLAUDE_RELAY_API_KEY=replace-with-a-long-random-relay-key
CLAUDE_RELAY_ADMIN_API_KEY=replace-with-a-different-long-random-admin-key

# Keep the service private by default. A local Caddy or Nginx can proxy to this address.
CLAUDE_RELAY_BIND_ADDRESS=127.0.0.1

# Optional outbound HTTP(S) proxy, for example http://host.docker.internal:7890 on Docker Desktop.
CLAUDE_RELAY_UPSTREAM_PROXY=

# Maximum accepted Anthropic JSON request size in bytes (32 MiB by default).
CLAUDE_RELAY_MAX_REQUEST_BYTES=33554432

# Emergency global refresh switch. Individual imported accounts still start disabled.
CLAUDE_RELAY_AUTO_REFRESH_ENABLED=true
