# Copy this file to .env and replace all four key values before running Docker Compose.
CLAUDE_RELAY_API_KEY=replace-with-a-long-random-relay-key
CLAUDE_RELAY_OFFICIAL_API_KEY=replace-with-a-different-long-random-official-key
CLAUDE_RELAY_ADMIN_API_KEY=replace-with-a-different-long-random-admin-key
CLAUDE_RELAY_AVAILABILITY_API_KEY=replace-with-a-different-long-random-read-only-key

# Keep the local default when building on the server, or use the private GHCR image after login.
# CLAUDE_RELAY_IMAGE=ghcr.io/paopaoandlingyia/clauderelay:latest

# Keep the service private by default. A local Caddy or Nginx can proxy to this address.
CLAUDE_RELAY_BIND_ADDRESS=127.0.0.1

# Optional outbound HTTP(S) proxy, for example http://host.docker.internal:7890 on Docker Desktop.
CLAUDE_RELAY_UPSTREAM_PROXY=

# Maximum accepted Anthropic JSON request size in bytes (32 MiB by default).
CLAUDE_RELAY_MAX_REQUEST_BYTES=33554432

# Hard per-account in-flight limit. Existing sticky sessions stay on their account and receive 429
# when it is full; new sessions may select another eligible account.
CLAUDE_RELAY_MAX_INFLIGHT_PER_ACCOUNT=3

# Independent short-request limit for /v1/messages/count_tokens. These requests do not consume
# Messages in-flight slots or active-session admission slots.
CLAUDE_RELAY_MAX_COUNT_TOKENS_INFLIGHT_PER_ACCOUNT=32

# New sessions are admitted only while fewer than this many bindings were active in the last 5 minutes.
CLAUDE_RELAY_MAX_ACTIVE_SESSIONS_PER_ACCOUNT=5

# Emergency global refresh switch. Individual imported accounts still start disabled.
CLAUDE_RELAY_AUTO_REFRESH_ENABLED=true

# In-memory request records shown in the console. Metadata only, never prompts. 0 turns it off.
CLAUDE_RELAY_REQUEST_LOG_SIZE=500
